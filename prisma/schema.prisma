generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma, so roles are plain strings.
// Valid values are "ADMIN" | "EMPLOYEE" (see src/lib/roles.ts).
model User {
  id            String   @id @default(cuid())
  employeeCode  String   @unique // login ID, e.g. "MC-001"
  name          String
  passwordHash  String
  role          String   @default("EMPLOYEE")
  hourlyRateRs  Float    @default(100)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // True until the employee has completed first-login onboarding (set their
  // own password + profile). Every new employee starts on the same shared
  // default password (see DEFAULT_EMPLOYEE_PASSWORD), so this gates access to
  // the rest of the app until they've replaced it with something only they know.
  // Only ever true for the admin-driven "add employee" fallback — someone who
  // signs up themselves (see `approved` below) sets their own password up
  // front and skips this entirely.
  mustChangePassword Boolean @default(true)

  // Gates access for self-signups (src/app/signup/). False until an admin
  // approves the account in the Employees tab — until then, the employee can
  // log in (and sees a "pending approval" screen) but is blocked from
  // clocking in or using the rest of the app. Employees added directly by an
  // admin (the manual fallback) are approved immediately, since there's
  // nothing to review.
  approved Boolean @default(false)

  // Profile fields, collected during onboarding.
  phone          String?
  alternatePhone String?
  address        String?
  hobbies        String?
  profilePhoto   String? // storage key under uploads/, same convention as attendance photos

  // 128-entry face-recognition descriptor (face-api.js), computed client-side
  // from the profile photo at onboarding and JSON-stringified as a plain
  // number array. Used to compare against clock-in/out selfies.
  faceDescriptor String?

  birthdayMonth Int?
  birthdayDay   Int?
  shareBirthday Boolean @default(false)
  muteChat      Boolean @default(false)
  chatSoundMode String @default("ADMIN") // ADMIN | ALL | OFF
  chatReadAt    DateTime?
  messages      TeamMessage[]
  reactions     MessageReaction[]
  notifications Notification[]
  acknowledgements AnnouncementAck[]
  requests      StaffRequest[]
  shifts        ScheduledShift[]
  pushSubscriptions PushSubscription[]

  // Recurring attendance rules apply from this IST date; null keeps legacy rules.
  customerReviewInvites CustomerReviewInvite[]
  customerReviews CustomerReview[]

  paidWeeklyOff Boolean @default(true) // independent of weekday-specific entry times
  unpaidBreakFrom String? // IST work date for employee-specific unpaid break
  scheduledUnpaidBreakMinutes Int?
  weeklyScheduleJson String? // weekday-keyed recurring rules; null uses standard daily rules
  attendancePolicyFrom String?
  attendanceStartMinute Int @default(570)
  attendanceLatestMinute Int @default(630)
  attendanceEndMinute Int @default(1350)
  attendanceAllowEarly Boolean @default(false)

  meetings ManagerMeeting[]
  arrivals ArrivalAttempt[]
  referrals ReferralClaim[]
  attendance    AttendanceRecord[]
  announcements Announcement[]     @relation("AnnouncementAuthor")
}

model AttendanceRecord {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  workDate String // YYYY-MM-DD in Asia/Kolkata, groups a shift's in/out together

  clockInAt      DateTime?
  clockInPhoto   String? // relative path under /uploads
  clockInGesture String? // legacy: gesture that was requested & verified (no longer used)
  clockInFaceMatch    Boolean? // did the clock-in selfie match the enrolled profile photo?
  clockInFaceDistance Float?   // raw euclidean distance (lower = more similar), for admin review

  clockOutAt      DateTime?
  clockOutPhoto   String?
  clockOutGesture String? // legacy: no longer used
  clockOutFaceMatch    Boolean?
  clockOutFaceDistance Float?

  // Legacy status retained for audit and explicit exclusions. Completed PENDING
  // and APPROVED records count automatically; REJECTED records stay excluded.
  approvalStatus String @default("PENDING")
  // Snapshots prevent future policy changes from rewriting historical payroll.
  unpaidBreakMinutes Int @default(60)
  extraTimeCutoff DateTime?
  extraTimeStatus String @default("NOT_REQUIRED") // AUTOMATIC for new extra time; legacy REJECTED remains excluded
  lateClockOutCutoff DateTime?
  lateClockOutStatus String @default("NOT_REQUIRED") // PENDING or REJECTED caps only time after 22:45 IST
  extraTimeReason String?
  lateArrivalRequestId String?
  policyVersion Int @default(0)
  shiftDurationMinutes Int @default(540)
  scheduledStartAt DateTime?
  scheduledEndAt DateTime?
  latePenaltyActive Boolean @default(false)
  earlyPenaltyActive Boolean @default(false)
  lateExcused Boolean @default(false)
  earlyExcused Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workDate])
  @@index([userId])
}

model Announcement {
  acknowledgements AnnouncementAck[]
  id        String   @id @default(cuid())
  title     String
  body      String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation("AnnouncementAuthor", fields: [authorId], references: [id])
}

// Immutable snapshots deliberately have no foreign keys: deleting a record or
// employee must not erase the history of an administrator's payroll decisions.
model AttendanceAudit {
  id           String   @id @default(cuid())
  recordId     String
  userId       String
  employeeName String
  employeeCode String
  workDate     String
  actorId      String
  actorName    String
  action       String
  beforeJson   String
  afterJson    String?
  createdAt    DateTime @default(now())

  @@index([workDate, createdAt])
  @@index([recordId])
}

model TeamMessage {
  id String @id @default(cuid())
  authorId String?
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body String
  replyToId String?
  replyTo TeamMessage? @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies TeamMessage[] @relation("Replies")
  reactions MessageReaction[]
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime @default(now())
  @@index([createdAt, id])
}
model MessageReaction {
  id String @id @default(cuid())
  messageId String
  message TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji String
  @@unique([messageId, userId, emoji])
}
model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  entityKey String
  title String
  href String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId, kind, entityKey])
  @@index([userId, readAt, createdAt])
}
model AnnouncementAck {
  id String @id @default(cuid())
  announcementId String
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime @default(now())
  @@unique([announcementId, userId])
}
model StaffRequest {
  verificationPhoto String?
  verificationDistance Float?
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  fromDate String
  toDate String
  reason String
  proposedIn DateTime?
  proposedOut DateTime?
  expectedRecordId String?
  expectedUpdatedAt DateTime?
  status String @default("PENDING")
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, status, fromDate])
}
model ScheduledShift {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate String
  startsAt DateTime
  endsAt DateTime
  note String @default("")
  updatedAt DateTime @updatedAt
  @@unique([userId, workDate])
}
model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
}

model ManagerMeeting {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  triggerDate String
  status String @default("PENDING")
  clearedDate String?
  reviewedAt DateTime?
  reviewedBy String?
  note String?
  createdAt DateTime @default(now())
  @@unique([userId, kind, triggerDate])
  @@index([userId, status])
}
model ArrivalAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workDate String
  arrivedAt DateTime
  photo String
  latitude Float?
  longitude Float?
  proposedAt DateTime?
  reason String?
  approvedAt DateTime?
  approvedBy String?
  @@unique([userId, workDate])
}
model ReferralClaim {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  billDate String
  billNumber String
  billKey String @unique
  partyReference String
  approvedPartyKey String? @unique
  reason String
  status String @default("PENDING")
  reviewedBy String?
  reviewedAt DateTime?
  note String?
  createdAt DateTime @default(now())
  @@index([userId, billDate])
}
model PolicyAudit {
  id String @id @default(cuid())
  entityId String
  userId String
  actorId String
  actorName String
  action String
  beforeJson String
  afterJson String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

model CustomerReviewInvite {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  code String? @unique
  activeUserId String? @unique
  expiresAt DateTime
  claimedAt DateTime?
  tokenHash String? @unique
  sessionExpiresAt DateTime?
  usedAt DateTime?
  createdAt DateTime @default(now())
  review CustomerReview?
  @@index([expiresAt])
}
model CustomerReview {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteId String @unique
  invite CustomerReviewInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  friendliness Int
  attentiveness Int
  accuracy Int
  speed Int
  overall Int
  totalStars Int
  points Float
  workDate String
  createdAt DateTime @default(now())
  @@index([userId, workDate])
}
model ReviewRateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}
