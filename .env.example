# Copy this file to .env and fill in real values before running.

# For local dev, SQLite file is fine. On Railway, mount a volume (e.g. at /data)
# and set this to "file:/data/prod.db" so attendance data survives redeploys.
DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions (JWT). Generate one with:
#   openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# Used only once, by `npm run seed`, to create the first admin login.
ADMIN_EMPLOYEE_CODE="ADMIN"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="ChangeMe123!"

# Shared starting password given to every newly-created employee login. They
# must set their own password (and complete their profile) the first time
# they sign in.
DEFAULT_EMPLOYEE_PASSWORD="Welcome123!"

# Optional: restricts clock-in/out to within RESTAURANT_RADIUS_METERS of this
# point (get lat/lng from Google Maps: right-click the spot -> click the
# coordinates to copy them). Leave both RESTAURANT_LAT and RESTAURANT_LNG
# unset to disable this check entirely (the default).
# RESTAURANT_LAT="26.9124"
# RESTAURANT_LNG="93.9333"
# RESTAURANT_RADIUS_METERS="200"

# Optional Web Push. Generate once with: npx web-push generate-vapid-keys --json
# Keep the private key secret; use the same keys across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.mcattendance.in

# Optional override for the built-in Manipur Chapter Google review link.
# Shown only after the employee review is saved. Set empty to hide the button.
# GOOGLE_REVIEW_URL="https://g.page/r/CX-VFZVmOSebEAE/review"

# Automatic English announcement calls to all active, approved employees.
# Enable only after provisioning the Twilio calling account and number.
ANNOUNCEMENT_VOICE_ENABLED=false
ANNOUNCEMENT_VOICE_BASE_URL=https://www.mcattendance.in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=

# Employee SMS account recovery via Twilio Verify (independent of voice calling).
SMS_RECOVERY_ENABLED=false
TWILIO_VERIFY_SERVICE_SID=

# One absence SMS per employee/workday, 15 minutes after scheduled start.
# Uses Programmable Messaging, not the Verify service above.
ATTENDANCE_SMS_ENABLED=false
ATTENDANCE_SMS_BASE_URL=https://www.mcattendance.in
# Configure an SMS-capable sender OR an MG Messaging Service with a sender pool.
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
