# Copy this file to .env and fill in real values before running.

# For local dev, SQLite file is fine. On Railway, mount a volume (e.g. at /data)
# and set this to "file:/data/prod.db" so attendance data survives redeploys.
DATABASE_URL="file:./dev.db"

# Long random string used to sign login sessions (JWT). Generate one with:
#   openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# Used only once, by `npm run seed`, to create the first admin login.
ADMIN_EMPLOYEE_CODE="ADMIN"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="ChangeMe123!"

# Shared starting password given to every newly-created employee login. They
# must set their own password (and complete their profile) the first time
# they sign in.
DEFAULT_EMPLOYEE_PASSWORD="Welcome123!"

# Optional: restricts clock-in/out to within RESTAURANT_RADIUS_METERS of this
# point (get lat/lng from Google Maps: right-click the spot -> click the
# coordinates to copy them). Leave both RESTAURANT_LAT and RESTAURANT_LNG
# unset to disable this check entirely (the default).
# RESTAURANT_LAT="26.9124"
# RESTAURANT_LNG="93.9333"
# RESTAURANT_RADIUS_METERS="200"

# Optional Web Push. Generate once with: npx web-push generate-vapid-keys --json
# Keep the private key secret; use the same keys across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://www.mcattendance.in
